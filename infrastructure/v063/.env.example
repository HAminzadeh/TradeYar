# Copy to .env in this folder, replace values, never commit .env.
TRADEYAR_TS_DB=tradeyar_timeseries
TRADEYAR_TS_USER=tradeyar_ts
TRADEYAR_TS_PASSWORD=replace-with-long-unique-random-password
TRADEYAR_NEO4J_AUTH=neo4j/replace-with-long-unique-random-password
TRADEYAR_CLICKHOUSE_USER=tradeyar
TRADEYAR_CLICKHOUSE_PASSWORD=replace-with-long-unique-random-password
TRADEYAR_OBJECT_ACCESS_KEY=replace-with-unique-access-key
TRADEYAR_OBJECT_SECRET_KEY=replace-with-long-random-secret-key
# Optional Neo4j GDS plugin; verify compatibility/license before enabling.
TRADEYAR_NEO4J_PLUGINS=[]
